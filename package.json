		"happy-dom": "^20.11.1",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.3",
		"svelte-check-native": "^0.7.2",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.9.3",
		"vite": "^8.1.5",
		"vitest": "^4.1.10",
		"wrangler": "^4.114.0"

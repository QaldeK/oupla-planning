{
	"name": "planing",
	"private": true,
	"version": "0.7.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check-native --output machine --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write . && prettier --write \"./src/**/*.svelte\"",
		"format:check": "biome format . && prettier --check \"./src/**/*.svelte\"",
		"gen": "wrangler types",
		"test:unit": "vitest run --config vitest.unit.config.ts",
		"test:integration": "vitest run --config vitest.integration.config.ts",
		"test:integration:watch": "vitest --config vitest.integration.config.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@inlang/paraglide-js": "^2.28.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@tauri-apps/cli": "^2.12.3",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/svelte": "^5.4.2",
		"@testing-library/user-event": "^14.6.8",
		"@types/eventsource": "^3.0.0",
		"@types/flatpickr": "^3.1.4",
		"@types/node": "^22.20.5",
		"@typescript/native-preview": "^7.0.0-dev.20260707.2",
		"daisyui": "^5.7.50",
		"eventsource": "^4.1.1",
		"fake-indexeddb": "^6.2.5",
		"happy-dom": "^20.14.6",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"svelte-check-native": "^0.7.2",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.9.3",
		"vite": "^8.3.4",
		"vitest": "^4.1.11",
		"wrangler": "^4.151.0"
	},
	"dependencies": {
		"@abhivarde/svelte-drawer": "^2.0.1",
		"@lucide/svelte": "^1.57.0",
		"@tauri-apps/api": "^2.12.4",
		"@tauri-apps/plugin-store": "^2.5.0",
		"@tiptap/core": "^3.32.0",
		"@tiptap/extension-bold": "^3.32.0",
		"@tiptap/extension-bullet-list": "^3.32.0",
		"@tiptap/extension-document": "^3.32.0",
		"@tiptap/extension-heading": "^3.32.0",
		"@tiptap/extension-italic": "^3.32.0",
		"@tiptap/extension-link": "^3.32.0",
		"@tiptap/extension-list-item": "^3.32.0",
		"@tiptap/extension-ordered-list": "^3.32.0",
		"@tiptap/extension-paragraph": "^3.32.0",
		"@tiptap/extension-text": "^3.32.0",
		"@tiptap/pm": "^3.32.0",
		"date-fns": "^4.4.0",
		"dexie": "^4.4.6",
		"dompurify": "^3.4.17",
		"pocketbase": "^0.27.3",
		"svelte-sonner": "^1.2.1",
		"zod": "^4.6.7"
	}
}
